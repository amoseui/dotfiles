# superpowers 작업 산출물 (spec/plan) — 로컬에만 보관, 커밋 제외
docs/superpowers/
.claude/worktrees/

# Hermes 스킬 런타임 상태/캐시 — 머신별 자동생성, 커밋 제외
hermes/skills/**/state.json
hermes/skills/**/__pycache__/
*.pyc

# Hermes 스킬 실제 설정 — 개인 식별값(경로/계정) 보관처, 커밋 제외.
# 템플릿은 config.example.yaml 로 커밋된다.
hermes/skills/**/config.yaml

# Hermes feed-pipeline 런타임/노이즈 파일 — 머신별 자동생성, 커밋 제외.
# (config.yaml / feeds.opml / newsletter-senders.json / scripts 는 추적한다.)
hermes/feed-pipeline/rss-seen.json
hermes/feed-pipeline/state/
hermes/feed-pipeline/**/__pycache__/

# Hermes credentials remain local and must never be committed.
hermes/.env
hermes/auth.json
**/.env
**/.env.*
!**/.env.example
hermes/state.db*
hermes/sessions/
hermes/logs/
hermes/webui/
hermes/cron/output/
hermes/cron/*.lock
hermes/cron/*.pid
hermes/cron/*ticker*
hermes/memories/

# Local service overrides and exported dashboard data never enter Git.
services/services.env
services/personal-observatory/data/
service-data-*/
