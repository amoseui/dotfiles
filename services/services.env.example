# Local service paths and network settings. Copy to:
#   ~/.config/dotfiles/services.env
# This file contains no credentials. Keep passwords/API keys in each app's local
# .env or in ~/.hermes/.env; never add them here to Git.

HERMES_WEBUI_REPO=$HOME/Workspace/github/hermes-webui
PERSONAL_OBSERVATORY_REPO=$HOME/Workspace/personal-observatory

# Services stay loopback-only. Tailscale Serve terminates HTTPS and proxies to
# these ports without exposing unauthenticated dashboards on LAN interfaces.
HERMES_WEBUI_HOST=127.0.0.1
HERMES_WEBUI_PORT=8787
PERSONAL_OBSERVATORY_HOST=127.0.0.1
PERSONAL_OBSERVATORY_PORT=8788
