<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.llama.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DOTFILES_ROOT__/services/run-llama-server.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.hermes/logs/llama-server.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.hermes/logs/llama-server.launchd.error.log</string>
</dict>
</plist>
