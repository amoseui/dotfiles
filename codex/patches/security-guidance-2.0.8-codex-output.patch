+def emit_codex_hook_json(output, **print_options):
+    """Preserve security feedback using Codex's strict hook output schema."""
+    output = dict(output)
+    metrics = output.pop("metrics", None)
+    if metrics is not None:
+        debug_log("Codex hook metrics: " + json.dumps(metrics))
+    summary = output.pop("rewakeSummary", None)
+    if summary and not output.get("systemMessage"):
+        output["systemMessage"] = summary
+    print(json.dumps(output), **print_options)
+
