{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.codex/herdr-agent-state.sh\" ]; then bash \"$HOME/.codex/herdr-agent-state.sh\" session; fi",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
